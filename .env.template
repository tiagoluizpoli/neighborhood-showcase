# =========================================================================
# Neighborhood Showcase - Environment Variables Template
# Copy this file to '.env' (in the root and in apps/server/ if needed)
# and fill in your actual credentials.
# =========================================================================

# -------------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------------
# The connection string for your primary PostgreSQL database.
# Local database runs in Docker (packages/db/docker-compose.yml) on port 5435
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/neighborhood_showcase"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="neighborhood_showcase"

# -------------------------------------------------------------------------
# Better Auth Configuration
# -------------------------------------------------------------------------
# A random secret key at least 32 characters long.
# You can generate a strong key using: openssl rand -hex 32
BETTER_AUTH_SECRET="a_very_long_secret_that_is_at_least_32_characters_long"
# Base URL of the backend API server running Better Auth
BETTER_AUTH_URL="http://localhost:3000"

# -------------------------------------------------------------------------
# CORS & Web Client Connections
# -------------------------------------------------------------------------
# Allowed CORS origin (typically the frontend dev server URL)
CORS_ORIGIN="http://localhost:3001"
# Public URL of the backend server (used by the frontend client)
VITE_SERVER_URL="http://localhost:3000"

# -------------------------------------------------------------------------
# General Environment Settings
# -------------------------------------------------------------------------
NODE_ENV="development"

# -------------------------------------------------------------------------
# S3 / MinIO File Storage Configuration
# -------------------------------------------------------------------------
# Local file storage uses MinIO (packages/db/docker-compose.yml)
# MinIO console runs on port 9001 (console) and API runs on port 9000
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="showcase"

# -------------------------------------------------------------------------
# AbacatePay Integration (Payment Gateway)
# -------------------------------------------------------------------------
# Sign up at: https://abacatepay.com/ to get your production keys.
# In development, you can use these mock values.
# API Key: Starts with 'pri_' or use the mock key for testing.
ABACATEPAY_API_KEY="mock-abacatepay-key"
# Webhook Secret: Used to sign webhook notifications sent by AbacatePay.
ABACATEPAY_WEBHOOK_SECRET="mock-webhook-secret"

# -------------------------------------------------------------------------
# Resend Email Integration (Optional)
# -------------------------------------------------------------------------
# Sign up at: https://resend.com/ to get an API Key for sending actual emails.
# If omitted or left empty, emails will fall back to local console mock logging.
RESEND_API_KEY=""

# -------------------------------------------------------------------------
# Unleash Feature Flagging Configuration
# -------------------------------------------------------------------------
UNLEASH_URL="http://localhost:4242/api"
UNLEASH_API_TOKEN="default:development.unleash-insecure-api-token"
UNLEASH_APP_NAME="neighborhood-showcase"

VITE_UNLEASH_URL="http://localhost:4242/api/frontend"
VITE_UNLEASH_CLIENT_KEY="default:development.unleash-insecure-api-token"

