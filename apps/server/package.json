{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@neighborhood-showcase/auth": "workspace:*",
    "@neighborhood-showcase/db": "workspace:*",
    "@neighborhood-showcase/env": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.0.0",
    "@hono/trpc-server": "^0.4.0",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "^5.3.3",
    "fastify-raw-body": "^5.0.0",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@neighborhood-showcase/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  }
}
