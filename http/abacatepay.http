@baseUrl = https://api.abacatepay.com/v2

# Define API key. Replace this placeholder with your actual dev key (e.g. from your local .env file).
@apiKey = abc_dev_JLLTNBMj0wMtAxXA6d2tcGuB

# Define the billing ID returned when clicking "Publicar Anúncio" in the app.
@billingId = pix_char_LGeAJRkabfPXFAG3zRsFbwRQ

### Simulate Payment
# Simulates approval of a PIX payment for a Transparent Checkout in Dev Mode.
# Flow: Publish an announcement in the app → copy the billingId from the payment screen → paste above → run this.
POST {{baseUrl}}/transparents/simulate-payment?id={{billingId}}
Authorization: Bearer {{apiKey}}
Content-Type: application/json
